{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/netkeep80/repo-guard/schemas/governance-grant.schema.json",
  "title": "Governance Grant",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 1,
  "properties": {
    "authorized_governance_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "allow_policy_relaxation": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^/"
      },
      "uniqueItems": true
    },
    "allow_atomic_governance_cutover": {
      "type": "boolean"
    },
    "size_rule_growth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_sha",
        "head_sha",
        "limits"
      ],
      "properties": {
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "limits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule_id",
              "max_growth"
            ],
            "properties": {
              "rule_id": {
                "type": "string",
                "minLength": 1
              },
              "max_growth": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "requirement_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_authority_sha256",
        "expected_head_authority_sha256",
        "add",
        "remove"
      ],
      "properties": {
        "base_authority_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "expected_head_authority_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "add": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/requirement_relation_tuple"
          },
          "uniqueItems": true
        },
        "remove": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/requirement_relation_tuple"
          },
          "uniqueItems": true
        }
      }
    },
    "trusted_root_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "authority_base_sha",
        "base_sha",
        "head_sha",
        "permissions"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "authority_base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "permissions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^trusted_root:[A-Za-z0-9_.-]+:[0-9a-f]{64}:[0-9a-f]{64}$"
          }
        }
      }
    },
    "transition_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "authority_base_sha",
        "base_sha",
        "head_sha",
        "permissions"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "authority_base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "permissions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:requirement:[A-Za-z][A-Za-z0-9._:-]*|resource:(?!.*[*?\\[\\]\\{\\}])\\S+|constraint(?:_definition)?:[A-Za-z][A-Za-z0-9._:-]*:[A-Za-z][A-Za-z0-9._:-]*|lifecycle:[A-Za-z][A-Za-z0-9._:-]*:(?:accepted|current|published))$"
          }
        }
      }
    }
  },
  "definitions": {
    "requirement_relation_tuple": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "relation",
        "object"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "enum": [
            "requires",
            "implements",
            "verifies",
            "documents",
            "immutable"
          ]
        },
        "object": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
