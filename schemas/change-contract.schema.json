{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/netkeep80/repo-guard/schemas/change-contract.schema.json",
  "title": "Change Intent",
  "type": "object",
  "required": ["change_type", "scope", "budgets", "must_touch", "must_not_touch", "expected_effects"],
  "additionalProperties": false,
  "properties": {
    "change_type": { "type": "string", "minLength": 1 },
    "scope": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "budgets": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "max_new_files": { "type": "integer", "minimum": 0 },
        "max_new_docs": { "type": "integer", "minimum": 0 },
        "max_net_added_lines": { "type": "integer", "minimum": 0 }
      }
    },
    "surface_debt": {
      "type": "object", "required": ["kind", "reason", "expected_delta", "repayment_issue"], "additionalProperties": false,
      "properties": {
        "kind": { "const": "temporary_growth" },
        "reason": { "type": "string", "minLength": 1 },
        "expected_delta": {
          "type": "object", "minProperties": 1, "additionalProperties": false,
          "properties": {
            "max_new_files": { "type": "integer", "minimum": 0 },
            "max_net_added_lines": { "type": "integer", "minimum": 0 }
          }
        },
        "repayment_issue": { "type": "integer", "minimum": 1 }
      }
    },
    "anchors": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "affects": { "$ref": "#/definitions/string_set" },
        "implements": { "$ref": "#/definitions/string_set" },
        "verifies": { "$ref": "#/definitions/string_set" }
      }
    },
    "must_touch": { "type": "array", "items": { "type": "string" } },
    "must_not_touch": { "type": "array", "items": { "type": "string" } },
    "expected_effects": { "type": "array", "items": { "type": "string" } }
  },
  "definitions": {
    "string_set": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
