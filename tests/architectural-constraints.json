{
  "required_paths": [
    ".github/workflows/compiler-gate.yml",
    "src/local-compiler.mts",
    "src/runtime/canonical-requirements.mts",
    "src/runtime/requirement-closure.mts",
    "src/runtime/resource-closure.mts",
    "src/runtime/transition-closure.mts",
    "src/projection-api.mts",
    "tests/test-ci-contract.mjs"
  ],
  "forbidden_paths": [
    ".github/workflows/pages.yml",
    ".github/workflows/trusted-enforcement.yml",
    ".github/ISSUE_TEMPLATE/change-intent.yml",
    ".github/PULL_REQUEST_TEMPLATE.md",
    "repo-policy.json",
    "schemas/repo-policy.schema.json",
    "schemas/change-intent.schema.json",
    "schemas/governance-grant.schema.json",
    "src/change-intent.mts",
    "src/check-diff.mts",
    "src/doctor.mts",
    "src/enforcement.mts",
    "src/init.mts",
    "src/policy-compiler.mts",
    "src/policy-packs.mts",
    "src/policy-vocabulary.mts",
    "src/validate.mts",
    "src/runtime/pipeline.mts",
    "src/runtime/validation.mts",
    "src/facts/control-plane.mts",
    "src/facts/input.mts",
    "scripts/observatory/collect.mjs",
    "scripts/observatory/render.mjs",
    "scripts/compression-metrics.mjs",
    "docs/self-hosting-coverage.json",
    "docs/requirements-strict-pack.md"
  ],
  "required_text": [
    {
      "path": "src/repo-guard.mts",
      "tokens": [
        "check:",
        "build:"
      ]
    },
    {
      "path": "README.md",
      "tokens": [
        "Snapshot",
        "+ SubjectRef",
        "+ Requirement",
        "+ Relation",
        "+ Constraint",
        "+ Projection"
      ]
    }
  ],
  "forbidden_text": [
    {
      "path": "src/repo-guard.mts",
      "tokens": [
        "check-diff",
        "doctor",
        "init",
        "validate",
        "--enforcement",
        "repo-policy"
      ]
    },
    {
      "path": "action.yml",
      "tokens": [
        "check-diff",
        "change-intent",
        "enforcement",
        "repo-policy.json"
      ]
    },
    {
      "path": ".github/workflows/ci.yml",
      "tokens": [
        "repo-policy.json",
        "check-diff",
        "doctor",
        "advisory policy"
      ]
    },
    {
      "path": "README.md",
      "tokens": [
        "repo-policy.json",
        "check-diff",
        "GovernanceGrant",
        "ChangeIntent"
      ]
    }
  ]
}
